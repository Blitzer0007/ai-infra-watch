# ============================================================
# ai-infra-watch backend — example environment
# Copy to `.env` and fill in. Nothing here is required for
# the default stub mode: the test suite and /api/eval run
# fully offline with LLM_PROVIDER=stub (the default).
# ============================================================

# --- provider selection ---------------------------------------------
# anthropic | openai | stub   (stub = deterministic fixtures, no key)
LLM_PROVIDER=stub
# Optional model override; per-provider defaults when unset:
#   anthropic -> claude-sonnet-4-5     openai -> gpt-4o-mini
# LLM_MODEL=claude-sonnet-4-5

# --- API keys (only needed for live runs) ---------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- eval behavior ----------------------------------------------------
# EVAL_SEMANTIC_THRESHOLD=0.7
# EVAL_EMBEDDING_MODEL=all-MiniLM-L6-v2   # enable real semantic embeddings
# EVAL_CACHE_ENABLED=true                  # .cache/<sha256>.json
# EVAL_TRACE=true                          # data/traces/*.jsonl
# EVAL_MAX_RETRIES=4
# EVAL_MAX_TOKENS=1200
# EVAL_TEMPERATURE=0.0

# --- CI ---------------------------------------------------------------
# CI_USE_STUB_LLM=true   # force stub mode even if keys are present


# --- SEC EDGAR filings ----------------------------------------------
# live reads the corpus produced by the scheduled GitHub Actions ingest.
# EDGAR ingest itself uses the same descriptive User-Agent value.
FILINGS_MODE=live
EDGAR_USER_AGENT=ai-infra-watch/1.0 (research; contact: replace-with-your-contact)
# Set USE_MCP=1 to route /api/ask through the MCP toolbox in deployments.
# USE_MCP=1

# --- scheduled earnings alerts (Vercel Node route) -------------------
# FINNHUB_API_KEY=...
# NOTIFY_WEBHOOK_URL=...
# CRON_SECRET=...
EARNINGS_ALERT_LEAD_DAYS=1

# --- Jev typed decision layer -----------------------------------------
# Optional server-side decision routing. Never put this key in React.
JEV_ENABLED=true
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SEC=3
JEV_ROUTE_THRESHOLD=0.75
# TYPESAFE_API_KEY=...
