# ---- ai-infra-watch runtime artifacts ---------------------------------
# LLM disk cache: machine-local, non-deterministic, and can SHADOW the
# committed stub fixtures if checked in. Never commit it.
.cache/
# Eval/synthesis traces are per-run observability output, not source.
data/traces/
# Local env / secrets.
.env

