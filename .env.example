# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional live market/news providers
ALPHA_VANTAGE_API_KEY=
MARKETAUX_API_KEY=

# ------------------------------------------------------------------
# LangGraph MCP integration
# ------------------------------------------------------------------
# With no explicit MCP config, agents automatically use the committed
# servers under aitracker-upload/mcp_servers/ when running locally.
#
# Market Agent -> mcp_servers/stocks/server.py
# Risk Agent   -> mcp_servers/filings/server.py
#
# The local Stocks MCP defaults to live Finnhub mode when configured.
# The local Filings MCP defaults to live EDGAR mode and uses the app's
# configured LLM provider; both agents retain graceful fallback paths.

# Optional explicit external Stocks MCP:
# AI_INFRA_WATCH_STOCKS_MCP_URL=http://localhost:8000/mcp
# AI_INFRA_WATCH_STOCKS_MCP_COMMAND=python
# AI_INFRA_WATCH_STOCKS_MCP_ARGS=["-m","mcp_servers.stocks.server"]
# AI_INFRA_WATCH_STOCKS_MCP_CWD=path/to/aitracker-upload
# AI_INFRA_WATCH_STOCKS_MCP_ENV_JSON={"STOCKS_MODE":"live"}
# AI_INFRA_WATCH_STOCKS_MCP_TOOL=get_quotes
# AI_INFRA_WATCH_STOCKS_MCP_ARGS_JSON={"symbols":["NVDA","DGXX"]}

# Optional explicit external Risk MCP (takes precedence over Filings MCP):
# AI_INFRA_WATCH_RISK_MCP_URL=http://localhost:8001/mcp
# AI_INFRA_WATCH_RISK_MCP_COMMAND=python
# AI_INFRA_WATCH_RISK_MCP_ARGS=["path/to/risk_server.py"]
# AI_INFRA_WATCH_RISK_MCP_TOOL=<tool_name>
# AI_INFRA_WATCH_RISK_MCP_ARGS_JSON={}

# Optional explicit Filings MCP override:
# AI_INFRA_WATCH_FILINGS_MCP_TOOL=answer_question
# AI_INFRA_WATCH_FILINGS_MCP_ARGS_JSON={"question":"..."}

# Live server settings
# FINNHUB_API_KEY=
# STOCKS_MODE=live
# FILINGS_MODE=live
# EDGAR_USER_AGENT=ai-infra-watch/0.1 (research; contact: you@example.com)

# LLM settings consumed by the live filings RAG service:
# LLM_PROVIDER=stub|openai|anthropic
# LLM_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Autonomous MCP investigation
# AUTONOMOUS_MODE=llm      -> LLM chooses the next MCP tool
# AUTONOMOUS_MODE=keyword  -> deterministic fallback planner
AUTONOMOUS_MODE=llm
AUTONOMOUS_MAX_STEPS=6

# ------------------------------------------------------------------
# Vercel -> Python autonomous-agent proxy
# ------------------------------------------------------------------
# Set these in the Vercel project environment, not in client-side code.
# AI_INFRA_AGENT_URL=https://your-python-backend.example.com
# AI_INFRA_AGENT_TOKEN=
