{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/quote",
      "destination": "/api/market/quote"
    },
    {
      "source": "/api/company-scale",
      "destination": "/api/market/company-scale"
    },
    {
      "source": "/api/contract-detail",
      "destination": "/api/market/contract-detail"
    },
    {
      "source": "/api/earnings-alerts",
      "destination": "/api/market/earnings-alerts"
    },
    {
      "source": "/api/ai-quality",
      "destination": "/api/quality/ai-quality"
    },
    {
      "source": "/api/signal-scorecard",
      "destination": "/api/quality/signal-scorecard"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/forecast-verification",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/portfolio-digest",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/signal-scorecard",
      "schedule": "30 23 * * *"
    }
  ],
  "functions": {
    "api/live-data.js": {
      "maxDuration": 30
    },
    "api/agent-ask.js": {
      "maxDuration": 60
    },
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{aitracker-upload/app/eval/**,aitracker-upload/app/harness/**,aitracker-upload/app/universe/**,aitracker-upload/tests/**,aitracker-upload/data/filings/**}"
    },
    "api/forecast-verification.js": {
      "maxDuration": 60
    }
  }
}
