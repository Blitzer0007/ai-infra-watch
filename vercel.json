{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/live-data.js": {
      "maxDuration": 30
    },
    "api/agent-ask.js": {
      "maxDuration": 60
    },
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{aitracker-upload/app/assertions/**,aitracker-upload/app/eval/**,aitracker-upload/app/harness/**,aitracker-upload/app/universe/**,aitracker-upload/tests/**}"
    },
    "api/earnings-alerts.js": {
      "maxDuration": 30
    }
  }
}
