{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/live-data.js": {
      "maxDuration": 30
    },
    "api/agent-ask.js": {
      "maxDuration": 60
    },
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{aitracker-upload/data/filings/**,aitracker-upload/tests/**,aitracker-upload/.cache/**,aitracker-upload/data/traces/**,.github/**,*.zip,node_modules/**,dist/**}"
    },
    "api/earnings-alerts.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/earnings-alerts?notify=1",
      "schedule": "0 3 * * *"
    }
  ]
}
