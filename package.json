{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && tsx server.ts",
    "build": "node scripts/build-frontend.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:unit": "tsx --test src/utils/*.test.ts server/api/*.test.js server/services/*.test.js",
    "security:audit": "node scripts/security-audit.mjs",
    "migration:verify": "node scripts/verify-migration-ledger.mjs",
    "serve:static": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@tailwindcss/postcss": "^4.1.14",
    "postcss": "^8.5.0"
  }
}
